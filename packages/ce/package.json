{
  "name": "continuous-evidence",
  "version": "0.1.0",
  "description": "Continuous Evidence core and CLI (v0 implementation spike). See SPEC.md at the repository root.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ce": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate:config-schema": "tsx src/scripts/generate-config-schema.ts",
    "verify:jev-image": "tsx --env-file-if-exists=../../.env src/scripts/verify-jev-image.ts",
    "update:catalog-snapshot": "tsx src/scripts/update-catalog-snapshot.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.0.0",
    "fast-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  }
}
